---
// src/pages/index.astro
import App from '@components/App';
import { loadQuestionData } from '@/data/loader';

const { questions } = loadQuestionData();
const jsonStr = JSON.stringify(questions);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiz Builder</title>
    <link rel="stylesheet" href="/quiz/app.css" />
    <script type="application/json" id="quiz-data" set:html={jsonStr}></script>
  </head>
  <body>
    <main style={{ padding: '16px', maxWidth: '1200px', margin: '0 auto' }} client:only="react">
      <App />
    </main>
  </body>
</html>
<style>
  body {
    min-height: 100vh;
    margin: 0;
  }
</style>
